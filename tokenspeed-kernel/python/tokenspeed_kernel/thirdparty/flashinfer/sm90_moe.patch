+template <typename OutputType, class GemmOutputType, ScaleMode SCALE_MODE>
+__global__ void finalizeMoeRoutingSmallMKernel(
+    GemmOutputType const* expanded_permuted_rows, OutputType* reduced_unpermuted_output,
+    float const* scales, int const* unpermuted_row_to_permuted_row,
+    int const* token_selected_experts, int64_t const num_rows, int64_t const padded_cols,
+    int64_t const unpadded_cols, int64_t const output_row_stride, int64_t const experts_per_token,
+    int const num_experts_per_node, int const start_expert_id) {
+  constexpr int64_t FINALIZE_ELEM_PER_THREAD =
+      128 / std::min(sizeof_bits<OutputType>::value, sizeof_bits<GemmOutputType>::value);
+  int64_t const original_row = blockIdx.x;
+  int64_t const elem_index = static_cast<int64_t>(blockIdx.y) * 32 + threadIdx.x;
+  int64_t const num_elems_in_padded_col = padded_cols / FINALIZE_ELEM_PER_THREAD;
+  int64_t const num_elems_in_orig_col = unpadded_cols / FINALIZE_ELEM_PER_THREAD;
+  int64_t const expanded_rows = num_rows * experts_per_token;
+
+  // Pre-filter local active experts in order before waiting on FC2 output.
+  // Routing metadata is finalized ahead of FC1 and never modified by FC1/FC2.
+  __shared__ int s_permuted_rows[32];
+  __shared__ float s_scales[32];
+  int const lane = threadIdx.x;
+  bool active = false;
+  int perm_row = -1;
+  float r_scale = 1.f;
+  if (lane < experts_per_token) {
+    int64_t const k_offset = original_row * experts_per_token + lane;
+    int const expert_id = token_selected_experts[k_offset] - start_expert_id;
+    if (expert_id >= 0 && expert_id < num_experts_per_node) {
+      int const pr = unpermuted_row_to_permuted_row[original_row + lane * num_rows];
+      if (pr >= 0 && pr < expanded_rows) {
+        active = true;
+        perm_row = pr;
+        r_scale = (SCALE_MODE == ScaleMode::NO_SCALE) ? 1.f : scales[k_offset];
+      }
+    }
+  }
+  unsigned const mask = __ballot_sync(0xffffffff, active);
+  int const count = __popc(mask);
+  if (active) {
+    int const slot = __popc(mask & ((1u << lane) - 1u));
+    s_permuted_rows[slot] = perm_row;
+    s_scales[slot] = r_scale;
+  }
+  __syncwarp();
+
+#if (defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900))
+  cudaGridDependencySynchronize();
+#endif
+
+  if (elem_index < num_elems_in_orig_col) {
+    using InputElem = cutlass::Array<GemmOutputType, FINALIZE_ELEM_PER_THREAD>;
+    using OutputElem = cutlass::Array<OutputType, FINALIZE_ELEM_PER_THREAD>;
+    using ComputeElem = cutlass::Array<float, FINALIZE_ELEM_PER_THREAD>;
+    auto const* expanded_v = reinterpret_cast<InputElem const*>(expanded_permuted_rows);
+    auto* reduced_row_ptr_v =
+        reinterpret_cast<OutputElem*>(reduced_unpermuted_output + original_row * output_row_stride);
+
+    ComputeElem thread_output;
+    thread_output.fill(0);
+    for (int i = 0; i < count; ++i) {
+      int const pr = s_permuted_rows[i];
+      float const row_scale = s_scales[i];
+      ComputeElem expert_result = arrayConvert<InputElem, ComputeElem>(
+          expanded_v[pr * num_elems_in_padded_col + elem_index]);
+      thread_output = thread_output + row_scale * expert_result;
+    }
+    reduced_row_ptr_v[elem_index] = arrayConvert<ComputeElem, OutputElem>(thread_output);
+  }
+#if (defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900))
+  cudaTriggerProgrammaticLaunchCompletion();
+#endif
+}
