+template <int kThreads = 256, int kMaxIters = 8>
+__global__ void fastBuildExpertMapsSmallMKernel(
+    int const* token_selected_experts, int* permuted_row_to_unpermuted_row,
+    int* unpermuted_row_to_permuted_row, int64_t* expert_first_token_offset,
+    int64_t const num_tokens, int const experts_per_token, int const start_expert,
+    int const end_expert, int const num_experts_per_node) {
+  int const tid = threadIdx.x;
+  int const total_expanded = static_cast<int>(num_tokens) * experts_per_token;
+
+  __shared__ int s_counts[kThreads];
+  __shared__ int s_offsets[kThreads];
+  using BlockScan = cub::BlockScan<int, kThreads>;
+  __shared__ typename BlockScan::TempStorage scan_temp;
+
+  s_counts[tid] = 0;
+
+#if (defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900))
+  cudaGridDependencySynchronize();
+#endif
+  __syncthreads();
+
+  auto const* ordered_experts = static_cast<int const volatile*>(token_selected_experts);
+  int local_expert[kMaxIters];
+  int local_slot[kMaxIters];
+  int n_iter = 0;
+  for (int idx = tid; idx < total_expanded; idx += kThreads) {
+    int const raw = ordered_experts[idx];
+    int const e = (raw >= start_expert && raw < end_expert) ? (raw - start_expert) : -1;
+    local_expert[n_iter] = e;
+    if (e >= 0) {
+      local_slot[n_iter] = atomicAdd(&s_counts[e], 1);
+    } else {
+      local_slot[n_iter] = -1;
+    }
+    ++n_iter;
+  }
+  __syncthreads();
+
+  int const count = (tid < num_experts_per_node) ? s_counts[tid] : 0;
+  int offset = 0;
+  int total_valid = 0;
+  BlockScan(scan_temp).ExclusiveSum(count, offset, total_valid);
+  if (tid < num_experts_per_node) {
+    s_offsets[tid] = offset;
+    expert_first_token_offset[tid] = offset;
+  }
+  if (tid == 0) {
+    expert_first_token_offset[num_experts_per_node] = total_valid;
+  }
+  __syncthreads();
+
+#if (defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900))
+  cudaTriggerProgrammaticLaunchCompletion();
+#endif
+
+  int iter = 0;
+  for (int idx = tid; idx < total_expanded; idx += kThreads) {
+    int const tok = idx / experts_per_token;
+    int const k = idx - tok * experts_per_token;
+    int const unpermuted_row = k * static_cast<int>(num_tokens) + tok;
+    int const e = local_expert[iter];
+    if (e >= 0) {
+      int const permuted_row = s_offsets[e] + local_slot[iter];
+      permuted_row_to_unpermuted_row[permuted_row] = unpermuted_row;
+      unpermuted_row_to_permuted_row[unpermuted_row] = permuted_row;
+    } else {
+      unpermuted_row_to_permuted_row[unpermuted_row] = total_expanded;
+    }
+    ++iter;
+  }
+}
